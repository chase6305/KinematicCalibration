# 300 mm square CCTAG_MULTI board, 1 mm thick, centred at the origin.
mtllib A4-300_300_3.mtl
o A4-300_300_3
v -0.150  0.150  0.001
v -0.150 -0.150  0.001
v  0.150 -0.150  0.001
v  0.150  0.150  0.001
v -0.150  0.150  0.000
v -0.150 -0.150  0.000
v  0.150 -0.150  0.000
v  0.150  0.150  0.000
vt 0.0 1.0
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vn 0.0 0.0 1.0
vn 0.0 0.0 -1.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 0.0 1.0 0.0
vn 0.0 -1.0 0.0
usemtl A4-300_300_3
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
f 8/1/2 7/2/2 6/3/2
f 8/1/2 6/3/2 5/4/2
usemtl board_edge
f 5//3 6//3 2//3
f 5//3 2//3 1//3
f 4//4 3//4 7//4
f 4//4 7//4 8//4
f 5//5 1//5 4//5
f 5//5 4//5 8//5
f 2//6 6//6 7//6
f 2//6 7//6 3//6
